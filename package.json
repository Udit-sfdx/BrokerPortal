{
  "name": "broker-portal-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Broker Portal demo site: a clickable, working website for UAE brokerages (static, plain JavaScript).",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/build.mjs --vendor",
    "pages": "node scripts/build.mjs --pages",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && npx --yes serve@14 build -l 3000",
    "test": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@salesforce-ux/design-system": "2.264.3"
  }
}
